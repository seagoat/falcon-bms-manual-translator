    "line_boxes": [
     [
      90,
      220.0,
      316.94,
      230.5
     ]
    ],
    "text": "• Throttle — engine thrust and afterburner selection",
    "role": "body",
    "style": {
     "bold": false,
     "italic": false,
     "size": 10,
     "color": 1710618,
     "align": "left",
     "list_level": 1,
     "indent": 0
    },
    "translation": {
     "text": "• 油门 — 发动机推力和加力选择",
     "status": "machine",
     "revision": 1
    }
   },
   {
