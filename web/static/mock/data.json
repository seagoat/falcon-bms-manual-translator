    ],
    "line_boxes": [
     [
      90,
      204.0,
      246.33,
      214.5
     ]
    ],
    "text": "• Rudder pedals — yaw commands",
    "role": "body",
    "style": {
     "bold": false,
     "italic": false,
     "size": 10,
     "color": 1710618,
     "align": "left",
     "list_level": 1,
     "indent": 0
    },
    "translation": {
     "text": "• 脚舵 — 偏航指令",
     "status": "machine",
     "revision": 1
    }
   },
   {
    "seg_id": 205,
