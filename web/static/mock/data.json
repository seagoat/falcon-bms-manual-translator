    "line_boxes": [
     [
      72,
      312.0,
      413.84,
      322.5
     ]
    ],
    "text": "The OBOGS provides breathing oxygen to the pilot during all phases of flight.",
    "role": "body",
    "style": {
     "bold": false,
     "italic": false,
     "size": 10,
     "color": 1710618,
     "align": "left",
     "list_level": 0,
     "indent": 0
    },
    "translation": {
     "text": "OBOGS 在飞行的所有阶段为飞行员提供呼吸用氧。",
     "status": "machine",
     "revision": 1
    }
   },
   {
